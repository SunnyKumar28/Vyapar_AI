# Secrets stay OUT of the repo. Copy to .env (gitignored) and fill in.
# The demo runs with dev-only defaults; these matter the moment you point it at real keys.

# Anthropic API key — only needed for VYAPAAR_LLM=claude (the scripted planner needs none)
# ANTHROPIC_API_KEY=

# Which brain: scripted (default, deterministic, offline) | sarvam | claude
# Sarvam uses the same tool registry, so answers stay grounded in the generated ledger.
VYAPAAR_LLM=scripted
VYAPAAR_MODEL=claude-opus-5

# Optional Sarvam voice. When set, the dashboard uses Saaras STT + Bulbul TTS.
# Leave empty to keep the browser's built-in voice fallback.
# SARVAM_API_KEY=
# Set VYAPAAR_LLM=sarvam to use Sarvam for text answers as well.
# VYAPAAR_MODEL=sarvam-105b-conversations
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_LANGUAGE=hi-IN
# SARVAM_SPEAKER=shubh

# HMAC secrets for PII tokenization and approval tokens. CHANGE THESE IN ANY REAL DEPLOYMENT.
VYAPAAR_PII_SECRET=dev-only-tokenization-key
VYAPAAR_APPROVAL_SECRET=dev-only-approval-key
